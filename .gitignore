# Terraform working directories
**/.terraform/*

# Terraform state files (may contain sensitive information)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files (may contain credentials or secrets)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Terraform CLI configuration and crash logs
.terraformrc
terraform.rc
crash.log
crash.*.log

# Terraform plan files
*.tfplan
tfplan
tfplan.*

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment and credential files
.env
.env.*
*.pem
*.key
*.p12

# Local editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Keep the Terraform dependency lock file tracked
!.terraform.lock.hcl